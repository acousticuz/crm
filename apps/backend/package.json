{
  "name": "@acoustic-crm/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Acoustic CRM backend — NestJS API",
  "scripts": {
    "build": "pnpm --filter @acoustic-crm/shared build && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --runInBand --passWithNoTests",
    "test:watch": "jest --watch",
    "prisma:seed": "node scripts/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@acoustic-crm/shared": "workspace:*",
    "bullmq": "5.21.2",
    "ioredis": "5.4.1",
    "@nestjs/common": "10.4.6",
    "@nestjs/config": "3.2.3",
    "@nestjs/core": "10.4.6",
    "@nestjs/event-emitter": "2.1.1",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.4.6",
    "@nestjs/platform-socket.io": "10.4.6",
    "@nestjs/websockets": "10.4.6",
    "socket.io": "4.8.0",
    "@prisma/client": "5.20.0",
    "argon2": "0.41.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "nestjs-cls": "4.4.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.6",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.13",
    "@types/node": "20.16.10",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "prisma": "5.20.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.4.5"
  }
}
