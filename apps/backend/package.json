{
  "name": "@acoustic-crm/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Acoustic CRM backend — NestJS API",
  "scripts": {
    "build": "pnpm --filter @acoustic-crm/shared build && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "echo \"backend: no tests yet in M0\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@acoustic-crm/shared": "workspace:*",
    "@nestjs/common": "10.4.6",
    "@nestjs/config": "3.2.3",
    "@nestjs/core": "10.4.6",
    "@nestjs/platform-express": "10.4.6",
    "@prisma/client": "5.20.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/schematics": "10.2.3",
    "@types/express": "4.17.21",
    "@types/node": "20.16.10",
    "prisma": "5.20.0",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.4.5"
  }
}
