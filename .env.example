# ============== Database ==============
# Host port differs from the container's 5432 to avoid clashes with other
# local projects running their own postgres. Container-internal port is 5432.
POSTGRES_HOST_PORT=5435
DATABASE_URL="postgresql://acoustic:acoustic@localhost:5435/acoustic_crm?schema=public"
POSTGRES_USER=acoustic
POSTGRES_PASSWORD=acoustic
POSTGRES_DB=acoustic_crm

# ============== Redis (BullMQ) ==============
REDIS_HOST_PORT=6380
REDIS_HOST=localhost
REDIS_PORT=6380

# ============== MinIO (S3-compatible object storage) ==============
MINIO_ROOT_USER=acoustic
MINIO_ROOT_PASSWORD=acoustic-minio-pass
MINIO_API_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101
MINIO_ENDPOINT=localhost
MINIO_PORT=9100
MINIO_USE_SSL=false
MINIO_BUCKET=acoustic-crm

# ============== Nginx (reverse proxy in front of backend+frontend) ==============
NGINX_HOST_PORT=8082

# ============== Backend ==============
BACKEND_PORT=3005
BACKEND_HOST=127.0.0.1
NODE_ENV=development
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Integration secrets encryption (Settings module). AES-256-GCM key source —
# any string >=16 chars; use 32+ random bytes in production. Rotating it
# invalidates stored integration credentials (must re-enter them).
ENCRYPTION_KEY=change-me-encryption-key-min-16-chars

# Telephony worker shared secret (backend <-> telephony-worker <-> ai-worker)
TELEPHONY_WORKER_SECRET=change-me-telephony-worker-secret
TELEPHONY_WORKER_URL=http://localhost:3008

# ============== Acoustic Analytics daily lead sync ==============
# Pulls /api/v1/clients/call-center-leads every day at 05:00 Uzbekistan time.
# ACOUSTIC_INTERNAL_API_KEY must match the Acoustic Analytics backend's INTERNAL_API_KEY.
ACOUSTIC_API_URL=https://YOUR_DOMAIN.uz/api
ACOUSTIC_INTERNAL_API_KEY=
ACOUSTIC_SYNC_ENABLED=false
# Optional comma-separated tenant ids. If empty, all ACTIVE tenants are synced.
ACOUSTIC_SYNC_TENANT_IDS=
ACOUSTIC_SYNC_HOUR=5
ACOUSTIC_SYNC_TZ_OFFSET_MINUTES=300
ACOUSTIC_SYNC_LIMIT=500
# Optional branch filter passed to Acoustic API, e.g. 9,11,16.
ACOUSTIC_SYNC_BRANCH_IDS=

# ============== Frontend ==============
VITE_API_URL=http://localhost:3005
VITE_SOCKET_URL=http://localhost:3005

# ============== Telephony (FreePBX/Asterisk AMI) ==============
# The worker prefers per-tenant FreePBX Integrations saved in Settings (pulled
# from the backend). These AMI_* vars are only a single-tenant fallback used
# when no Integration is configured. AMI_MODE=asterisk enables real AMI.
AMI_MODE=mock
AMI_HOST=
AMI_PORT=5038
AMI_USERNAME=
AMI_PASSWORD=
AMI_TENANT_ID=
# How often (ms) the worker re-fetches saved FreePBX configs and reconnects.
AMI_SYNC_INTERVAL_MS=30000

# ============== SMS providers — set per tenant in DB ==============
# Placeholders only (used in M5)
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
PLAYMOBILE_BASE_URL=https://send.smsxabar.uz/broker-api

# ============== AI providers — adapter-configurable in M7/M8 ==============
STT_PROVIDER=mock
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ============== Voice-AI worker (real-time AGI IVR) ==============
# Only needed when running apps/voice-ai-worker. Disabled by default.
VOICE_AI_TENANT_ID=
VOICE_AI_AGI_PORT=4573
VOICE_AI_AGI_HOST=0.0.0.0
VOICE_AI_RECORDINGS_DIR=/var/spool/asterisk/voice-ai
VOICE_AI_GREETING_SOUND=acoustic/greeting-uz
VOICE_AI_TRANSFER_CONTEXT=
VOICE_AI_CLAUDE_MODEL=claude-opus-4-7
VOICE_AI_STT_MODEL=phone_call
VOICE_AI_MAX_TURNS=18
VOICE_AI_MAX_SILENCE_MS=3000
VOICE_AI_MAX_TURN_MS=30000
# JSON map {"<tenantId>":"<webhookSecret>"} — when set, AI-collected leads
# are posted to /api/v1/leads/webhook/:tenantId/voice-ai for human follow-up.
VOICE_AI_WEBHOOK_SECRETS=
VOICE_AI_INBOUND_NUMBER=
# Telegram summary (optional, separate bot from the CRM's TELEGRAM Integration)
VOICE_AI_TELEGRAM_BOT_TOKEN=
VOICE_AI_TELEGRAM_BRANCH_CHATS=
VOICE_AI_TELEGRAM_MASTER_CHAT_ID=
# Google Cloud creds shared with the STT/TTS clients
GOOGLE_APPLICATION_CREDENTIALS=
TTS_CACHE_DIR=/tmp/voice-ai-tts-cache
# Business hours used in the agent's call-back phrasing
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18
BUSINESS_DAYS=1,2,3,4,5,6
BUSINESS_TZ=Asia/Tashkent
