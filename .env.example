# ============== Database ==============
# Host port differs from the container's 5432 to avoid clashes with other
# local projects running their own postgres. Container-internal port is 5432.
POSTGRES_HOST_PORT=5435
DATABASE_URL="postgresql://acoustic:acoustic@localhost:5435/acoustic_crm?schema=public"
POSTGRES_USER=acoustic
POSTGRES_PASSWORD=acoustic
POSTGRES_DB=acoustic_crm

# ============== Redis (BullMQ) ==============
REDIS_HOST_PORT=6380
REDIS_HOST=localhost
REDIS_PORT=6380

# ============== MinIO (S3-compatible object storage) ==============
MINIO_ROOT_USER=acoustic
MINIO_ROOT_PASSWORD=acoustic-minio-pass
MINIO_API_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101
MINIO_ENDPOINT=localhost
MINIO_PORT=9100
MINIO_USE_SSL=false
MINIO_BUCKET=acoustic-crm

# ============== Nginx (reverse proxy in front of backend+frontend) ==============
NGINX_HOST_PORT=8082

# ============== Backend ==============
BACKEND_PORT=3005
NODE_ENV=development
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Integration secrets encryption (Settings module). AES-256-GCM key source —
# any string >=16 chars; use 32+ random bytes in production. Rotating it
# invalidates stored integration credentials (must re-enter them).
ENCRYPTION_KEY=change-me-encryption-key-min-16-chars

# Telephony worker shared secret (backend <-> telephony-worker <-> ai-worker)
TELEPHONY_WORKER_SECRET=change-me-telephony-worker-secret
TELEPHONY_WORKER_URL=http://localhost:3008

# ============== Frontend ==============
VITE_API_URL=http://localhost:3005
VITE_SOCKET_URL=http://localhost:3005

# ============== Telephony (FreePBX/Asterisk AMI) ==============
# The worker prefers per-tenant FreePBX Integrations saved in Settings (pulled
# from the backend). These AMI_* vars are only a single-tenant fallback used
# when no Integration is configured. AMI_MODE=asterisk enables real AMI.
AMI_MODE=mock
AMI_HOST=
AMI_PORT=5038
AMI_USERNAME=
AMI_PASSWORD=
AMI_TENANT_ID=
# How often (ms) the worker re-fetches saved FreePBX configs and reconnects.
AMI_SYNC_INTERVAL_MS=30000

# ============== SMS providers — set per tenant in DB ==============
# Placeholders only (used in M5)
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
PLAYMOBILE_BASE_URL=https://send.smsxabar.uz/broker-api

# ============== AI providers — adapter-configurable in M7/M8 ==============
STT_PROVIDER=mock
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
